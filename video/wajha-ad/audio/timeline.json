{
 "dur": 55.421,
 "lines": [
  {
   "i": 0,
   "start": 0.4,
   "end": 1.404,
   "text": "مَحَلُّكْ جَميل"
  },
  {
   "i": 1,
   "start": 1.804,
   "end": 2.007,
   "text": "لكِنْ"
  },
  {
   "i": 2,
   "start": 2.167,
   "end": 2.883,
   "text": "مَنْ يَعْلَم؟"
  },
  {
   "i": 3,
   "start": 3.363,
   "end": 5.907,
   "text": "زَبونُكَ اليَوْمَ لا يَمُرُّ مِنَ الشّارِع"
  },
  {
   "i": 4,
   "start": 6.147,
   "end": 7.795,
   "text": "بَلْ مِنْ شاشَةِ هاتِفِه."
  },
  {
   "i": 5,
   "start": 8.195,
   "end": 9.857,
   "text": "وَأَوَّلُ ما يَراهُ مِنْك"
  },
  {
   "i": 6,
   "start": 10.097,
   "end": 11.527,
   "text": "يَجِبُ أَنْ يَليقَ بِك."
  },
  {
   "i": 7,
   "start": 12.007,
   "end": 13.207,
   "text": "أَنا عَبْدُ الله،"
  },
  {
   "i": 8,
   "start": 13.367,
   "end": 15.322,
   "text": "وَواجِهَة عَمَلُها واحِد:"
  },
  {
   "i": 9,
   "start": 15.522,
   "end": 17.826,
   "text": "أَنْ يَظْهَرَ مَحَلُّكْ كَما يَسْتَحِقّ."
  },
  {
   "i": 10,
   "start": 18.226,
   "end": 19.758,
   "text": "مِنْيو رَقْمِيٌّ لِمَطْعَمِك"
  },
  {
   "i": 11,
   "start": 19.958,
   "end": 22.106,
   "text": "يُفْتَحُ مِنْ رَمْزٍ عَلى الطّاوِلَة."
  },
  {
   "i": 12,
   "start": 22.426,
   "end": 26.384,
   "text": "مَوْقِعٌ لِعِيادَتِك، لِمَحَلِّك، لِمَكْتَبِكَ الهَنْدَسِيّ."
  },
  {
   "i": 13,
   "start": 26.704,
   "end": 28.963,
   "text": "وَفيديو تَرْويجِيٌّ لِحِساباتِك"
  },
  {
   "i": 14,
   "start": 29.163,
   "end": 31.121,
   "text": "مِثْلُ الَّذي تُشاهِدُهُ الآن."
  },
  {
   "i": 15,
   "start": 31.521,
   "end": 33.757,
   "text": "لَيْسَ قالَبًا واحِدًا لِلْجَميع"
  },
  {
   "i": 16,
   "start": 33.997,
   "end": 36.385,
   "text": "أَلْوانُك، شِعارُك، هُوِيَّتُك."
  },
  {
   "i": 17,
   "start": 36.785,
   "end": 38.1,
   "text": "لِلْهاتِفِ أَوَّلًا،"
  },
  {
   "i": 18,
   "start": 38.22,
   "end": 39.984,
   "text": "بِالعَرَبِيَّةِ مِنَ الأَساس،"
  },
  {
   "i": 19,
   "start": 40.104,
   "end": 42.097,
   "text": "بِلا تَطْبيقٍ وَلا تَسْجيل."
  },
  {
   "i": 20,
   "start": 42.497,
   "end": 43.641,
   "text": "تُرْسِلُ المُحْتَوى"
  },
  {
   "i": 21,
   "start": 43.801,
   "end": 44.097,
   "text": "أَبْني"
  },
  {
   "i": 22,
   "start": 44.257,
   "end": 44.782,
   "text": "تُراجِع"
  },
  {
   "i": 23,
   "start": 44.942,
   "end": 46.89,
   "text": "وَتَسْتَلِمُ الرّابِطَ جاهِزًا."
  },
  {
   "i": 24,
   "start": 47.29,
   "end": 49.694,
   "text": "واجِهَتُكَ الرَّقْمِيَّةُ تَبْدَأُ بِرِسالَة."
  },
  {
   "i": 25,
   "start": 49.934,
   "end": 51.479,
   "text": "راسِلْني عَلى واتْساب."
  },
  {
   "i": 26,
   "start": 52.039,
   "end": 52.401,
   "text": "واجِهَة"
  },
  {
   "i": 27,
   "start": 52.641,
   "end": 53.821,
   "text": "تَليقُ بِمَحَلِّك."
  }
 ],
