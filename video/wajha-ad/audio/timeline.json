 "lines": [
  {"start": 0.07, "end": 0.81, "text": "محلّك زين…"},
  {"start": 1.37, "end": 2.5, "text": "بس… منو يدري؟"},
  {"start": 3.31, "end": 5.14, "text": "زبونك اليوم ما يمرّ من الشارع…"},
  {"start": 5.95, "end": 7.01, "text": "يمرّ من شاشة موبايله."},
  {"start": 7.71, "end": 9.26, "text": "وأول شي يشوفه منك…"},
  {"start": 9.5, "end": 10.64, "text": "لازم يليق بيك."},
  {"start": 11.14, "end": 12.73, "text": "أني عبدالله، من الموصل."},
  {"start": 13.03, "end": 14.58, "text": "وواجهة شغلتها وحدة:"},
  {"start": 14.84, "end": 17.29, "text": "تجعل محلّك يبيّن مثل ما يستاهل."},
  {"start": 17.72, "end": 19.03, "text": "منيو رقمي لمطعمك…"},
  {"start": 19.23, "end": 21.3, "text": "يفتح من رمز QR على الطاولة."},
  {"start": 21.57, "end": 24.84, "text": "موقع لعيادتك، لمحلّك، لمكتبك الهندسي."},
  {"start": 25.07, "end": 26.7, "text": "وفيديو ترويجي لحساباتك…"},
  {"start": 26.93, "end": 28.24, "text": "مثل هذا اللي تشوفه هسه."},
  {"start": 28.52, "end": 29.86, "text": "مو قالب ينطي للكل…"},
  {"start": 30.17, "end": 32.77, "text": "ألوانك، شعارك، هويتك إنت."},
  {"start": 33.03, "end": 34.07, "text": "للموبايل أولاً،"},
  {"start": 34.29, "end": 37.39, "text": "بالعربي من الأساس، وبلا تطبيق ولا تسجيل."},
  {"start": 37.79, "end": 42.38, "text": "تدزلي المحتوى… أني أبني… إنت تراجع… وتستلم الرابط جاهز."},
  {"start": 42.64, "end": 44.8, "text": "واجهتك الرقمية تبدي برسالة."},
  {"start": 45.12, "end": 46.29, "text": "راسلني على واتساب."},
  {"start": 46.54, "end": 48.44, "text": "واجهة… تليق بمحلّك."},
  {"start": 48.7, "end": 53.97, "text": "واتساب: 0774 780 0611"}
 ],
