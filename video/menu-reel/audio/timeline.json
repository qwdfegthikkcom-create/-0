 "lines": [
  {"start": 0.07, "end": 1.51, "text": "منيوك… بعده ورق؟"},
  {"start": 1.99, "end": 3.17, "text": "كل ما يتغيّر سعر…"},
  {"start": 3.45, "end": 4.40, "text": "تطبع من جديد."},
  {"start": 4.70, "end": 6.54, "text": "ويتوسّخ… ويتمزّق."},
  {"start": 6.84, "end": 7.63, "text": "خلّيه رقمي."},
  {"start": 7.90, "end": 9.19, "text": "الزبون يمسح الرمز…"},
  {"start": 9.33, "end": 10.62, "text": "والمنيو يفتح بموبايله."},
  {"start": 10.94, "end": 12.62, "text": "بلا تطبيق، ولا تسجيل."},
  {"start": 12.90, "end": 14.37, "text": "بألوان مطعمك وشعاره."},
  {"start": 14.69, "end": 15.64, "text": "تريد تغيّر سعر؟"},
  {"start": 15.87, "end": 17.81, "text": "تدزلي وأعدّله، بلا طباعة."},
  {"start": 18.15, "end": 19.09, "text": "الفرق واضح."},
  {"start": 19.35, "end": 20.71, "text": "منيو رقمي لمطعمك…"},
  {"start": 20.91, "end": 21.93, "text": "راسلني على واتساب:"},
  {"start": 22.21, "end": 26.43, "text": "صفر سبعة سبعة أربعة، سبعة ثمانية صفر، صفر ستة واحد واحد."}
 ],
